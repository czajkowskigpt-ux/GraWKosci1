<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5DC"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#A52A2A"
        android:gravity="center"
        android:padding="16dp"
        android:text="Gra w kości. \n Autor: Adam Czajkowski"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnRoll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:backgroundTint="#D2691E"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="RZUĆ KOŚĆMI"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/diceContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivDice1"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:contentDescription="Kość 1"
            android:scaleType="fitCenter"
            android:src="@drawable/question" />

        <ImageView
            android:id="@+id/ivDice2"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:contentDescription="Kość 2"
            android:scaleType="fitCenter"
            android:src="@drawable/question" />

        <ImageView
            android:id="@+id/ivDice3"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:contentDescription="Kość 3"
            android:scaleType="fitCenter"
            android:src="@drawable/question" />

        <ImageView
            android:id="@+id/ivDice4"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:contentDescription="Kość 4"
            android:scaleType="fitCenter"
            android:src="@drawable/question" />

        <ImageView
            android:id="@+id/ivDice5"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:contentDescription="Kość 5"
            android:scaleType="fitCenter"
            android:src="@drawable/question" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRollScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Wynik tego losowania: 0"
        android:textColor="#000000"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvGameScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Wynik gry: 0"
        android:textColor="#000000"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnReset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:backgroundTint="#D2691E"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="RESETUJ WYNIK"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>